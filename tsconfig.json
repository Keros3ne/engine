{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023", "dom", "dom.iterable"],
		"types": ["bun", "node"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noUncheckedSideEffectImports": false
	},
	"include": ["src/**/*.ts", "bin/**/*.ts", "*.ts"]
}
