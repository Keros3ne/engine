		"./bets": "./src/bets.ts",
		"./book": "./src/book.ts",
		"./book-check": "./src/book-check.ts",
		"./book-files": "./src/book-files.ts",
		"./book-game": "./src/book-game.ts",
		"./book-round": "./src/book-round.ts",
		"./frame": "./src/frame.ts",
		"./game-failed": "./src/game-failed.ts",
		"./game-manifest": "./src/game-manifest.ts",
		"./guide": "./src/guide.ts",
		"./kero": "./src/kero.ts",
		"./limits": "./src/limits.ts",
		"./listing": "./src/listing.ts",
		"./maths": "./src/maths.ts",
		"./memory": "./src/memory.ts",
		"./pipeline": "./src/pipeline.ts",
		"./play": "./src/play.ts",
		"./proofs": "./src/proofs.ts",
		"./protocol": "./src/protocol.ts",
		"./rng": "./src/rng.ts",
		"./serve": "./src/serve.ts",
		"./shapes": "./src/shapes.ts",
		"./stake-steps": "./src/stake-steps.ts",
		"./stand-in": "./src/stand-in.ts",
		"./verify": "./src/verify.ts",
		"./verify-books": "./src/verify-books.ts"
	},
	"scripts": {
		"test": "bun --bun vitest --run",
