	},
	"dependencies": {
		"@noble/hashes": "^2.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "^22",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
